  "augmentation_coach_templates": [
    {
      "domain": "augmentation",
      "focus": "Focus on the craft_dimensions section: per-dimension prompt-maturity averages (constraints, success criteria, verification, context, specificity) and the intent-class mix. Identify the weakest one or two dimensions and recommend concrete prompt-writing habits that raise them, referencing the observed averages. Do not comment on tool reliability or security unless craft data is absent.",
      "id": "prompt_maturity_review",
      "title": "Prompt craft review",
      "version": 1
    },
    {
      "domain": "augmentation",
      "focus": "Focus on the totals and workspaces sections: always-on context tax (tokens burned per prompt), dead always-on rules, and workspace instruction sprawl. Recommend which artifacts to demote to on-demand, merge, or delete, citing the specific counts. Weigh the craft context-provision average as supporting evidence for whether context is reaching the agent effectively.",
      "id": "context_setup_review",
      "title": "Context setup review",
      "version": 1
    },
    {
      "domain": "augmentation",
      "focus": "Focus on workflow-hygiene signals in craft_dimensions and health_summary: stuck re-asks, frustration sessions, runaway tool loops, duplicate prompts, and the health grade distribution with its penalty counts. Diagnose the dominant failure pattern (going in circles vs runaway automation vs abandoned sessions) and recommend session-management habits that break it.",
      "id": "workflow_hygiene_review",
      "title": "Workflow hygiene review",
      "version": 1
    },
    {
      "domain": "augmentation",
      "focus": "Focus on the failure_clusters section and the leverage sub-score: recurring tool/error-class clusters, error rates in skill-assisted vs unassisted sessions, and edit churn. Recommend which failing tool workflows to stabilize first and whether a skill would encode the fix, citing cluster session counts.",
      "id": "tool_reliability_review",
      "title": "Tool reliability review",
      "version": 1
    },
    {
      "domain": "augmentation",
      "focus": "Focus on the skill_opportunities and skills sections: recurring no-skill failure clusters that meet the recurrence floors, dead or dormant skills, and skill utilization signals. Recommend the one or two highest-value skills to author or resurrect, citing the cluster evidence, and any dead weight to prune.",
      "id": "skill_opportunity_review",
      "title": "Skill opportunity review",
      "version": 1
    },
    {
      "domain": "security",
      "focus": "Focus on the security_signals section: secret-exposure hits and labels, prompt-injection bait hits and labels, and context-compaction events. Treat any secret exposure as the top priority (surface each live secret and its source for the operator to rotate manually, then propose the source cleanup), injection bait second (locate the source and propose neutralizing it), compaction third (task splitting). Cite the exact hit counts and labels; do not speculate beyond the supplied signals.",
      "id": "security_hygiene_review",
      "title": "Security hygiene review",
      "version": 1
    }
  ],
  "augmentation_prompt_templates": [
    {
      "id": "broken_ref",
      "prompt": "My agent instruction files contain {count} file(s) with unresolved reference(s) to other skills/rules:\n{items}\n\nEach bullet is `referring_file -> missing_target` (the target name/slug that does not resolve in the on-disk inventory). For each one: confirm whether the target skill/rule exists under a different path (e.g. `skills/<name>/SKILL.md`), then either fix the reference path or remove the stale reference. Do NOT rewrite unrelated short rule-to-rule links. Show me a diff for each file before applying.",
      "title": "Repair broken instruction references"
    },
    {
      "id": "ghost_reuse",
      "prompt": "These skills were invoked in my agent sessions but have no file on disk in this workspace ({count} total):\n{items}\n\nFor each, check whether it lives in another workspace or was deleted. If it is genuinely useful here, recreate it as a proper skill file (SKILL.md or rule) in this workspace; otherwise tell me why it keeps being referenced.",
      "title": "Materialize ghost skills"
    },
    {
      "id": "duplicate_skill",
      "prompt": "These instruction artifacts overlap heavily in content ({count} cluster(s)):\n{items}\n\nFor each cluster, compare the files, merge them into one canonical skill keeping the best parts of each, update anything that references the removed copies, and delete the redundant files. Show me the merged content before deleting anything.",
      "title": "Merge duplicate skills"
    },
    {
      "id": "context_tax",
      "prompt": "These always-loaded instruction files dominate my standing per-prompt token cost ({count} hotspot(s)):\n{items}\n\nRewrite each to be dramatically shorter: keep only invariants and hard constraints inline, move examples, walkthroughs and reference material into on-demand skill files, and delete anything the codebase itself already documents. Target at least a 50% token reduction per file. Show diffs before applying.",
      "title": "Shrink the standing context tax"
    },
    {
      "id": "dormant_no_desc",
      "prompt": "These on-demand skills were never invoked and have no description/frontmatter, so agents cannot discover them ({count} total):\n{items}\n\nFor each, read the skill body and write a one-sentence trigger-oriented description (when should an agent reach for this?) in its frontmatter. If the skill is obsolete, propose deleting it instead.",
      "title": "Describe dormant skills so agents can find them"
    },
    {
      "id": "dead_on_demand",
      "prompt": "These on-demand skills exist on disk but were never used in the observation window ({count} total):\n{items}\n\nFor each, judge from its content whether it is still relevant to this codebase. Propose keep / improve-description / merge / delete, then apply the agreed actions.",
      "title": "Prune dead on-demand skills"
    },
    {
      "id": "low_quality",
      "prompt": "These instruction files scored low on structural authoring quality ({count} total):\n{items}\n\nFor each: add proper frontmatter (name + trigger description), a clear task contract, concrete examples, and split anything over ~200 lines into focused sub-skills. Show me a before/after summary per file.",
      "title": "Raise structural quality of weak skills"
    },
    {
      "id": "workspace_sprawl",
      "prompt": "These {count} skill(s)/command(s) were used from workspace {workspace} and also from other workspaces (cross-workspace reuse):\n{items}\n\nPropose a consolidation plan: pick a canonical home (shared agent-level skill vs one workspace copy), list which duplicates to remove or redirect, and preserve capability. Apply changes only after I confirm.",
      "title": "Consolidate cross-workspace skill reuse"
    },
    {
      "id": "skill_opportunity",
      "prompt": "My agent sessions WITHOUT any skill assist keep failing the same way: tool `{tool}` failing with `{error_class}` in {session_count} separate sessions ({error_hits} total errors). Investigate why this keeps happening in this codebase, then author an on-demand skill (SKILL.md) that encodes the correct recipe: the working command/approach, the pitfall that causes `{error_class}`, and a verification step. Place it where our other skills live.",
      "title": "Author a skill for a recurring failure"
    },
    {
      "id": "compaction",
      "prompt": "{count} recent agent session(s) on {agent} hit mid-task context compaction (the conversation exceeded the context window and was summarized, losing detail). Review how work is being batched: propose how to split the recurring long tasks into smaller scoped runs, and whether a skill or rule could front-load the context that keeps being re-derived.",
      "title": "Split work to avoid context-window compaction"
    },
    {
      "id": "secret_exposure",
      "prompt": "Secret material ({labels}) was detected in {agent} transcript context. First confirm each hit is a real, live credential: a masked display, a one-time code, or a bare variable name is not a leak. Then trace how it got there: shell history exports, .env files read into prompts, and tool outputs that echo credentials. For each genuinely live secret, highlight it and its exact source and hand it to me; I will revoke or rotate it at the provider, since you cannot do that yourself. Finally, propose for my confirmation, with no edits applied yet, adding the source files to ignore/exclusion lists and reworking workflows so secrets are referenced by name, never pasted.",
      "title": "Purge secrets from agent context"
    },
    {
      "id": "prompt_injection",
      "prompt": "Prompt-injection bait ({labels}) was detected in {agent} transcript context.\n\nMatched exact bait phrases (case-insensitive substrings):\n{markers}\n\nOffending transcript path(s):\n{paths}\n\nGrep those paths for the quoted phrases above to locate the source turn (file read, web page, dependency README, tool output, or agent rules). Assess whether the agent acted on the injected instruction. Then show me the offending content and propose how to neutralize it, either a sanitized rewrite or removal, and apply only after I confirm.",
      "title": "Investigate prompt-injection bait"
    }
  ],
